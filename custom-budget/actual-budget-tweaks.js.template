  // The number leaf under a header label inside `container` (the label
  // and its value share a column container). Returns null when missing.
  function valueUnderLabel(container, label) {
    var all = container.querySelectorAll
      ? container.querySelectorAll('*')
      : [];
    var labelEl = null;
    for (var i = 0; i < all.length; i++) {
      if (
        all[i].children &&
        all[i].children.length === 0 &&
        leafText(all[i]) === label
      ) {
        labelEl = all[i];
        break;
      }
    }
    if (!labelEl) return null;
    var node = labelEl;
    for (var d = 0; d < 3 && node; d++) {
      node = node.parentElement;
      if (!node) break;
      var leaves = node.querySelectorAll ? node.querySelectorAll('*') : [];
