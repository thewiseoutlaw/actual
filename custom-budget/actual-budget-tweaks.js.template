        FALLBACK.brokerageA + FALLBACK.brokerageB + FALLBACK.brokerageC;
      b.brokerageA = FALLBACK.brokerageA;
      b.brokerageB = FALLBACK.brokerageB;
      b.brokerageC = FALLBACK.brokerageC;
    }
    if (
      hasAll(live, [
        'cashA',
        'cashB',
        'cashC',
        'cashD',
        'cashOnHand',
        'cardA',
        'cardD',
        'cardB',
        'cardC',
        'cardE',
        'cardF',
        'cardG',
        'cardH',
