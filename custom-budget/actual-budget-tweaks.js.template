  // How much is currently spent. Live values only when the month,
  // the budget and the spent amount all validate; otherwise the
  // config figures. Returns { spent, budget, month, live }.
  function readSpent() {
    var fallback = {
      spent: FALLBACK.novSpent,
      budget: FALLBACK.novBudget,
      month: '{{CURRENT_MONTH_NAME}}',
      live: false,
    };
    try {
      var vals = readTableHeaderValues();
      var month = readSelectedMonth();
      if (
        month === '{{CURRENT_MONTH_NAME}}' &&
        vals.budgeted !== null &&
        vals.spent !== null
      ) {
        var budget = vals.budgeted;
        var spent = Math.abs(vals.spent);
        if (
          Math.abs(budget - FALLBACK.novBudget) <= 1 &&
          spent >= 0 &&
          spent <= 100000
        ) {
          return { spent: spent, budget: budget, month: '{{CURRENT_MONTH_NAME}}', live: true };
        }
