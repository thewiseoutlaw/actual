        if (leaves[j] === labelEl) continue;
        if (isNumberLeaf(leaves[j])) {
          var v = parseAmount(leaves[j].textContent);
          if (v !== null) return v;
        }
      }
    }
    return null;
  }

  // Budgeted and Spent totals from the budget TABLE HEADER row only.
  // Anchored on the "Category" label (the summary card has no such
  // label), so the summary card's "Budgeted" line can never be read.
  function readTableHeaderValues() {
    var out = { budgeted: null, spent: null };
    var all = document.getElementsByTagName('*');
    for (var i = 0; i < all.length; i++) {
      var el = all[i];
      if (!el.children || el.children.length !== 0) continue;
      if (leafText(el) !== 'Category') continue;
      var node = el;
      for (var d = 0; d < 4 && node; d++) {
        node = node.parentElement;
        if (!node) break;
        var leaves = node.querySelectorAll ? node.querySelectorAll('*') : [];
