  // Compact monthly income-vs-spending bar strip (months from the config), with
  // the saved amount under each month (green when positive, red when
  // negative). Returns an SVG string, or '' when the data is missing.
  function monthlyBarsSVG() {
    try {
      var data = YEAR.monthly;
      if (!data || data.length === 0) return '';
      var W = 660;
      var H = 132;
      var padL = 40;
      var padR = 8;
      var padT = 8;
      var padB = 34;
      var plotW = W - padL - padR;
      var plotH = H - padT - padB;
      var maxV = 0;
      for (var i = 0; i < data.length; i++) {
        maxV = Math.max(maxV, data[i].income, data[i].spending);
      }
      if (maxV <= 0) return '';
      maxV = Math.ceil(maxV / 10000) * 10000;
      function y(v) {
        return padT + plotH * (1 - v / maxV);
      }
      var s =
        '<svg viewBox="0 0 ' +
        W +
        ' ' +
        H +
        '" width="100%" ' +
        'style="display:block;" role="img" aria-label="Monthly income vs spending (config data)">';
      var g;
      for (g = 0; g <= maxV; g += 10000) {
        var gy = y(g);
        s +=
          '<line x1="' +
          padL +
          '" y1="' +
          gy.toFixed(1) +
          '" x2="' +
          (W - padR) +
          '" y2="' +
          gy.toFixed(1) +
          '" stroke="rgba(128,128,128,0.25)" stroke-width="1"/>' +
          '<text x="' +
          (padL - 5) +
          '" y="' +
          (gy + 3).toFixed(1) +
          '" text-anchor="end" ' +
          'font-size="9" fill="#888">$' +
          g / 1000 +
          'k</text>';
      }
      var slot = plotW / data.length;
      var barW = Math.min(22, (slot - 12) / 2);
      for (var m = 0; m < data.length; m++) {
        var cx = padL + slot * m + slot / 2;
        var x0 = cx - barW - 2;
        var x1 = cx + 2;
        var ih = plotH * (data[m].income / maxV);
        var sh = plotH * (data[m].spending / maxV);
        s +=
          '<rect x="' +
          x0.toFixed(1) +
          '" y="' +
          (padT + plotH - ih).toFixed(1) +
          '" width="' +
          barW +
          '" height="' +
          ih.toFixed(1) +
          '" fill="' +
          GREEN +
          '" rx="2">' +
          '<title>' +
          data[m].m +
          ' income $' +
          fmt(data[m].income) +
          '</title></rect>';
        s +=
          '<rect x="' +
          x1.toFixed(1) +
          '" y="' +
          (padT + plotH - sh).toFixed(1) +
          '" width="' +
          barW +
          '" height="' +
          sh.toFixed(1) +
          '" fill="#78909c" rx="2">' +
          '<title>' +
          data[m].m +
          ' spending $' +
          fmt(data[m].spending) +
          '</title></rect>';
        s +=
          '<text x="' +
          cx.toFixed(1) +
          '" y="' +
          (padT + plotH + 12) +
          '" text-anchor="middle" ' +
          'font-size="10" fill="#555">' +
          data[m].m +
          '</text>';
        var saved = data[m].saved;
        var sColor = saved >= 0 ? GREEN : RED;
        var sTxt = (saved >= 0 ? '+' : '\u2212') + '$' + fmt(Math.abs(saved));
        s +=
          '<text x="' +
          cx.toFixed(1) +
          '" y="' +
          (padT + plotH + 25) +
          '" text-anchor="middle" ' +
          'font-size="9" font-weight="600" fill="' +
          sColor +
          '">' +
          sTxt +
          '</text>';
      }
      s += '</svg>';
      return s;
    } catch (e) {
      return '';
    }
  }

  // Savings-goal tracker, compact: one slim bar per quarter plus the
  // annual line. Two lines per row (label + bar); the shortfall sits
  // on the label line. A negative quarter shows an empty bar with the
  // amount in red. Returns HTML, or '' if no data.
  function goalTrackerHTML() {
    try {
      var q = GOALS.quarters;
      if (!q || q.length === 0) return '';
      var h = '';
      for (var i = 0; i < q.length; i++) {
        var saved = q[i].saved;
        var target = GOALS.quarterlyTarget;
        var pct =
          saved > 0
            ? Math.max(0, Math.min(100, (saved / target) * 100))
            : 0;
        var short = target - saved;
        var sColor = saved >= 0 ? GREEN : RED;
        var sTxt = (saved >= 0 ? '+' : '\u2212') + '$' + fmt(Math.abs(saved));
        h +=
          '<div style="margin-top:6px;">' +
          '<div style="display:flex;justify-content:space-between;gap:8px;font-size:12px;">' +
          '<span>' +
          esc(q[i].label) +
          '</span>' +
          '<span style="white-space:nowrap;"><b style="color:' +
          sColor +
          ';">' +
          sTxt +
          '</b> <span style="opacity:0.75;">of $' +
          fmt(target) +
          '</span>' +
          (short > 0
            ? ' <span style="opacity:0.75;">&middot; short $' + fmt(short) + '</span>'
            : ' <span style="color:' + GREEN + ';">goal met</span>') +
          '</span></div>' +
          '<div style="height:6px;border-radius:3px;background:rgba(128,128,128,0.25);margin-top:3px;overflow:hidden;">' +
          '<div style="height:100%;width:' +
          pct.toFixed(1) +
          '%;background:' +
          GREEN +
          ';border-radius:3px;"></div></div></div>';
      }
      // Annual line.
      var ySaved = GOALS.yearToDate;
      var yTarget = GOALS.annualTarget;
      var yPct =
        ySaved > 0 ? Math.max(0, Math.min(100, (ySaved / yTarget) * 100)) : 0;
      var yShort = yTarget - ySaved;
      var yColor = ySaved >= 0 ? GREEN : RED;
      var yTxt = (ySaved >= 0 ? '+' : '\u2212') + '$' + fmt(Math.abs(ySaved));
      h +=
        '<div style="margin-top:6px;">' +
        '<div style="display:flex;justify-content:space-between;gap:8px;font-size:12px;">' +
        '<span><b>Year so far</b> <span style="font-size:11px;opacity:0.75;">({{YEAR_LABEL}})</span></span>' +
        '<span style="white-space:nowrap;"><b style="color:' +
        yColor +
        ';">' +
        yTxt +
        '</b> <span style="opacity:0.75;">of $' +
        fmt(yTarget) +
        '</span>' +
        (yShort > 0
          ? ' <span style="opacity:0.75;">&middot; short $' + fmt(yShort) + '</span>'
          : ' <span style="color:' + GREEN + ';">goal met</span>') +
        '</span></div>' +
        '<div style="height:6px;border-radius:3px;background:rgba(128,128,128,0.25);margin-top:3px;overflow:hidden;">' +
        '<div style="height:100%;width:' +
        yPct.toFixed(1) +
        '%;background:' +
        GREEN +
        ';border-radius:3px;"></div></div></div>';
      return h;
    } catch (e) {
      return '';
    }
  }

  /* ------------------------------------------------------------------ */
  /* Compact additions block (Budget page)                               */
  /* ------------------------------------------------------------------ */
  // One slim block above the budget table — no tall panel, no border,
  // no background, no fixed height, no position/overflow tricks. The
  // Budget page keeps its original compact feel and keeps scrolling.

  function compactAdditionsHTML(b, spent) {
    var left = spent.budget - spent.spent;
    var pctSpent =
      spent.budget > 0
        ? Math.max(0, Math.min(100, (spent.spent / spent.budget) * 100))
        : 0;
    var goals = goalTrackerHTML();
    var bars = monthlyBarsSVG();
    var mayDiff = b.liquidPlusHomeEquity - FALLBACK.may1Liquid;
    var essentiallyBack =
      Math.abs(mayDiff) <= Math.max(5000, FALLBACK.may1Liquid * 0.01);
    var netColor = b.netWorth >= 0 ? GREEN : RED;
    var h = '';
    // 1. Savings goal, at the top.
    if (goals) {
      h +=
        '<div style="margin-bottom:8px;">' +
        '<div style="font-weight:700;font-size:13px;">Savings goal &mdash; ${{QUARTERLY_TARGET_FMT}} a quarter, ${{ANNUAL_TARGET_FMT}} a year</div>' +
        goals +
        '<div style="font-size:12px;opacity:0.8;margin-top:4px;">Behind pace for the year. At budget spending (${{CURRENT_BUDGET_FMT}}/mo) the model says ${{QUARTERLY_TARGET_K}}k/quarter is reachable next year &mdash; the gap is the spending pace, and {{CURRENT_MONTH_NAME}} ({{CURRENT_MONTH_SAVED_FMT}}) was on pace. That is a model, not a promise.</div>' +
        '</div>';
    }
    // 2. Net worth strip (one line + May line + small detail line).
    h +=
      '<div style="margin-bottom:8px;">' +
      '<div style="display:flex;justify-content:space-between;gap:12px;align-items:baseline;">' +
      '<span style="font-weight:700;font-size:14px;">Total net worth <span style="font-weight:400;font-size:12px;opacity:0.75;">(incl. home ${{HOME_VALUE_FMT}})</span></span>' +
      '<span style="font-weight:700;font-size:16px;color:' +
      netColor +
      ';white-space:nowrap;">$' +
      fmt(b.netWorth) +
      '</span></div>' +
      '<div style="font-size:12px;margin-top:2px;">Liquid + home equity $' +
      fmt(b.liquidPlusHomeEquity) +
      ' vs May 1 $' +
      fmt(FALLBACK.may1Liquid) +
      ' &mdash; <b>' +
      (mayDiff >= 0 ? '+' : '\u2212') +
      '$' +
      fmt(Math.abs(mayDiff)) +
      '</b> ' +
      (essentiallyBack
        ? '<span style="color:' + GREEN + ';font-weight:700;">essentially back to the May amount.</span>'
        : '<span style="color:' + RED + ';font-weight:700;">not back to the May amount yet.</span>') +
      '</div>' +
      '<div style="font-size:11px;opacity:0.7;margin-top:2px;">Brokerage $' +
      fmt(b.brokerage) +
      ' &middot; Liquid $' +
      fmt(b.netSpendable) +
      ' &middot; Retirement $' +
      fmt(b.retirement) +
      ' &middot; Home equity $' +
      fmt(b.homeEquity) +
      ' &middot; Other $' +
      fmt(b.other) +
      '</div></div>';
    // 3. Spent this month (compact line + slim bar). "Over budget" is
    // only ever shown when spent is genuinely above the budget.
    h +=
      '<div style="margin-bottom:8px;">' +
      '<div style="display:flex;justify-content:space-between;gap:12px;font-size:13px;">' +
      '<span>Spent in ' +
      esc(spent.month) +
      '</span><span><b>$' +
      fmt(spent.spent) +
      '</b> of $' +
      fmt(spent.budget) +
      ' budget</span></div>' +
      '<div style="height:5px;border-radius:3px;background:rgba(128,128,128,0.25);margin-top:4px;overflow:hidden;">' +
      '<div style="height:100%;width:' +
      pctSpent.toFixed(1) +
      '%;background:' +
      (left >= 0 ? GREEN : RED) +
      ';border-radius:3px;"></div></div>' +
      '<div style="font-size:12px;opacity:0.8;margin-top:3px;">' +
      (left >= 0
        ? '$' + fmt(left) + ' left in the budget'
        : '$' + fmt(-left) + ' over budget') +
      (spent.live ? '' : ' (config figures)') +
      '</div></div>';
    // 4. Monthly bar strip.
    if (bars) {
      h +=
        '<div style="margin-bottom:4px;">' +
        '<div style="font-weight:700;font-size:12px;">Monthly income vs spending</div>' +
        '<div style="font-size:11px;opacity:0.7;"><span style="color:' +
        GREEN +
        ';">&#9632;</span> Income &nbsp;<span style="color:#78909c;">&#9632;</span> Spending &nbsp;Saved under each month</div>' +
        bars +
        '</div>';
    }
    h +=
      '<div style="font-size:11px;opacity:0.6;">' +
      (b.allLive
        ? 'Balances read live from the sidebar.'
        : 'Showing config figures.') +
      '</div>';
    return h;
  }

  function ensureAdditions() {
    var table = document.querySelector('[data-testid="budget-table"]');
    if (!table) return;
    var anchor =
      document.querySelector(
        '[data-testid="budget-table-scroll-container"]',
      ) || document.querySelector('[data-testid="budget-groups"]');
    if (!anchor || !anchor.parentElement) return;
    // Remove the old tall v1-v3 panel if it is lingering.
    var old = document.getElementById
      ? document.getElementById(OLD_PANEL_ID)
      : null;
    if (old && old.parentElement) old.parentElement.removeChild(old);
    var b = computeBuckets();
    var spent = readSpent();
    var html = compactAdditionsHTML(b, spent);
    var block = document.getElementById
      ? document.getElementById(ADDITIONS_ID)
      : null;
    if (block) {
      if (block.innerHTML !== html) block.innerHTML = html;
      if (block.nextSibling !== anchor) {
        anchor.parentElement.insertBefore(block, anchor);
      }
      return;
    }
    block = document.createElement('div');
    block.id = ADDITIONS_ID;
    // Compact by design: no border, no background, no fixed height,
    // no position/overflow — nothing here may trap page scrolling.
    block.setAttribute('style', 'margin:0 0 10px;padding:2px 0;');
    block.innerHTML = html;
    anchor.parentElement.insertBefore(block, anchor);
  }

  /* ------------------------------------------------------------------ */
  /* Uncategorized view: hide transfer rows (display only)               */
  /* ------------------------------------------------------------------ */
  // The Uncategorized list is mostly transfers — money moving between
  // the user's own accounts (mortgage payments, card payments, the down
  // payment). They are correctly recorded as transfers and do not need
  // a spending category, so this hides them (display only; no data is
  // changed) and leaves the transactions that genuinely need a
  // category. A small note with a Show/Hide toggle is added above the
  // table, and the view total is recomputed from the visible rows
  // when it can be read reliably. If the table structure cannot be
  // recognised, this no-ops rather than breaking the page.

  var transfersHidden = true; // default: transfers hidden in Uncategorized
  var TRANSFER_HIDDEN_ATTR = 'data-actual-tweaks-hidden-transfer';
  var ORIG_TOTAL_ATTR = 'data-actual-tweaks-orig-total';

  function isUncategorizedView() {
    if (!document.querySelector('[data-testid="transaction-table"]')) {
      return false;
    }
    var all = document.getElementsByTagName('*');
    for (var i = 0; i < all.length; i++) {
      var el = all[i];
      if (
        el.children &&
        el.children.length === 0 &&
        leafText(el) === 'Uncategorized'
      ) {
        return true;
      }
    }
    return false;
  }

  function findTransactionTable() {
    return document.querySelector('[data-testid="transaction-table"]');
  }

  // NOTE: no \b word-boundary anchors here. A row's textContent is its
  // cells concatenated with NO separator ("12/25/2099Cash Account B..."), so a
  // trailing \b after the year fails whenever the next cell starts with a
  // word character, and a leading \b fails when the previous cell ends in
  // a digit. Match the date pattern anywhere in the text instead.
  function hasDateText(el) {
    return /\d{1,2}\/\d{1,2}\/\d{4}/.test(el.textContent || '');
  }

  // Walk up from a transfer-icon button to the row element. The row
  // is the ancestor that contains a date and whose parent holds
  // several date-containing siblings (the list of rows). Returns null
  // when no such ancestor is found.
  function rowForIcon(iconEl, tableEl) {
    var node = iconEl;
    for (var d = 0; d < 10 && node; d++) {
      node = node.parentElement;
      if (!node) break;
      if (node === tableEl) break;
      if (
        node.getAttribute &&
        node.getAttribute('data-testid') === 'transaction-table-header'
      ) {
        break;
      }
      if (!hasDateText(node)) continue;
      var parent = node.parentElement;
      if (!parent) continue;
      var sibs = parent.children || [];
      var dateKids = 0;
      for (var i = 0; i < sibs.length; i++) {
        if (hasDateText(sibs[i])) dateKids++;
      }
      if (sibs.length >= 2 && dateKids >= 2) return node;
    }
    return null;
  }

  // Index of the Date cell within a row (cells are the row's children).
  function dateCellIndex(row) {
    var cells = row.children || [];
    for (var i = 0; i < cells.length; i++) {
      var t = (cells[i].textContent || '').trim();
      if (/^\d{1,2}\/\d{1,2}\/\d{4}$/.test(t)) return i;
    }
    return -1;
  }

  function cellText(row, idx) {
    var cells = row.children || [];
    if (idx < 0 || idx >= cells.length) return '';
    return (cells[idx].textContent || '').trim();
  }

  // A row is a transfer when Actual tags it with a transfer-icon,
  // or (fallback) its payee starts with an arrow or its notes start
  // with "transfer:". Column order is the standard Date / Account /
  // Payee / Notes / Category / Payment / Deposit, so the payee is
  // Date+2 and the notes Date+3.
  function isTransferRow(row) {
    try {
      var icons = row.querySelectorAll
        ? row.querySelectorAll('[data-testid="transfer-icon"]')
        : [];
      if (icons && icons.length > 0) return true;
    } catch (e) {}
    var di = dateCellIndex(row);
    if (di === -1) return false;
    var payee = cellText(row, di + 2);
    if (payee.charAt(0) === '\u2192' || payee.charAt(0) === '\u2190') {
      return true;
    }
    var notes = cellText(row, di + 3);
    if (notes.toLowerCase().indexOf('transfer:') === 0) return true;
    return false;
  }

  // The list container inside the table: the element (not the header)
  // whose children each contain a date. Its children are the rows.
  function findRowsInTable(tableEl) {
    var all = tableEl.querySelectorAll ? tableEl.querySelectorAll('*') : [];
    var best = null;
    var bestCount = 0;
    for (var i = 0; i < all.length; i++) {
      var el = all[i];
      if (
        el.getAttribute &&
        el.getAttribute('data-testid') === 'transaction-table-header'
      ) {
        continue;
      }
      var kids = el.children || [];
      if (kids.length < 2) continue;
      var dateKids = 0;
      for (var j = 0; j < kids.length; j++) {
        if (hasDateText(kids[j])) dateKids++;
      }
      if (dateKids >= 2 && dateKids > bestCount) {
        best = el;
        bestCount = dateKids;
      }
    }
    if (!best) return [];
    var rows = [];
    var kids2 = best.children || [];
    for (var k = 0; k < kids2.length; k++) rows.push(kids2[k]);
    return rows;
  }

  // The view total (the big number under the "Uncategorized" heading).
  function findTransactionsTotalEl() {
    var el = document.querySelector('[data-testid="transactions-balance"]');
    if (el) return el;
    var all = document.getElementsByTagName('*');
    for (var i = 0; i < all.length; i++) {
      var e = all[i];
      if (e.children && e.children.length === 0) {
        var t = (e.textContent || '').trim();
        if (/^-?\$?[\d,]+\.\d{2}$/.test(t)) return e;
      }
    }
    return null;
  }

  function formatTotal(n, origText) {
    var sign = n < 0 ? '-' : '';
    var dollar =
      origText && origText.indexOf('$') !== -1 ? '$' : '';
    return sign + dollar + fmt(Math.abs(n));
  }

  function applyTransfers() {
    try {
      if (!isUncategorizedView()) return;
      var tableEl = findTransactionTable();
      if (!tableEl) return;

      // Collect transfer rows (dedupe by element).
      var transferRows = [];
      function addRow(r) {
        if (!r) return;
        for (var i = 0; i < transferRows.length; i++) {
          if (transferRows[i] === r) return;
        }
        transferRows.push(r);
      }
      // Primary: Actual's own transfer-icon tags transfer rows.
      var icons = tableEl.querySelectorAll
        ? tableEl.querySelectorAll('[data-testid="transfer-icon"]')
        : [];
      for (var a = 0; a < icons.length; a++) {
        addRow(rowForIcon(icons[a], tableEl));
      }
      // Fallback: scan rows for an arrow payee or "transfer:" notes.
      var rows = findRowsInTable(tableEl);
      for (var b = 0; b < rows.length; b++) {
        if (isTransferRow(rows[b])) addRow(rows[b]);
      }
      if (transferRows.length === 0) return;

      // Parse each transfer row's amount (Deposit - Payment) so the
      // view total can be recomputed from the visible rows. Column
      // order is Date / Account / Payee / Notes / Category /
      // Payment / Deposit, so Payment is Date+5 and Deposit Date+6.
      var hiddenSum = 0;
      var allParsed = true;
      for (var c = 0; c < transferRows.length; c++) {
        var row = transferRows[c];
        var di = dateCellIndex(row);
        if (di === -1) {
          allParsed = false;
          break;
        }
        var pay = parseAmount(cellText(row, di + 5));
        var dep = parseAmount(cellText(row, di + 6));
        if (pay === null && dep === null) {
          allParsed = false;
          break;
        }
        hiddenSum += (dep || 0) - (pay || 0);
      }

      // The view total: keep the original text so the toggle can restore it.
      var totalEl = findTransactionsTotalEl();
      var origTotal = null;
      var origText = null;
      if (totalEl) {
        origText = (totalEl.textContent || '').trim();
        var stored =
          totalEl.getAttribute
            ? totalEl.getAttribute(ORIG_TOTAL_ATTR)
            : null;
        if (stored !== null && stored !== '') {
          origTotal = parseAmount(stored);
          origText = stored;
        } else {
          origTotal = parseAmount(origText);
          if (origTotal !== null && totalEl.setAttribute) {
            totalEl.setAttribute(ORIG_TOTAL_ATTR, origText);
          }
        }
      }

      if (transfersHidden) {
        for (var d = 0; d < transferRows.length; d++) {
          var r2 = transferRows[d];
          if (r2.style) r2.style.display = 'none';
          if (r2.setAttribute) {
            r2.setAttribute(TRANSFER_HIDDEN_ATTR, '1');
          }
        }
        if (totalEl && origTotal !== null && allParsed) {
          totalEl.textContent = formatTotal(origTotal - hiddenSum, origText);
        }
      } else {
        for (var e2 = 0; e2 < transferRows.length; e2++) {
          var r3 = transferRows[e2];
          if (r3.style) r3.style.display = '';
          if (r3.setAttribute) {
            r3.setAttribute(TRANSFER_HIDDEN_ATTR, '');
          }
        }
        if (totalEl) {
          var stored2 =
            totalEl.getAttribute
              ? totalEl.getAttribute(ORIG_TOTAL_ATTR)
              : null;
          if (stored2 !== null && stored2 !== '') {
            totalEl.textContent = stored2;
          }
        }
      }

      // Small note above the table with a Show/Hide toggle.
      var note = document.getElementById
        ? document.getElementById(TRANSFER_NOTE_ID)
        : null;
      var count = transferRows.length;
      var noteText = transfersHidden
        ? count +
          ' transfer' +
          (count === 1 ? '' : 's') +
          ' hidden \u2014 money moving between your own accounts; they don\u2019t need a category. '
        : count +
          ' transfer' +
          (count === 1 ? '' : 's') +
          ' shown. ';
      var btnLabel = transfersHidden ? 'Show transfers' : 'Hide transfers';
      if (!note) {
        note = document.createElement('div');
        note.id = TRANSFER_NOTE_ID;
        note.setAttribute(
          'style',
          'font-size:12px;opacity:0.85;margin:0 0 6px;',
        );
        var span = document.createElement('span');
        var btn = document.createElement('button');
        btn.setAttribute(
          'style',
          'margin-left:6px;padding:2px 8px;border:1px solid rgba(128,128,128,0.4);border-radius:4px;background:transparent;cursor:pointer;font-size:12px;',
        );
        btn.onclick = function () {
          transfersHidden = !transfersHidden;
          applyTransfers();
        };
        note.appendChild(span);
        note.appendChild(btn);
        if (tableEl.parentElement) {
          tableEl.parentElement.insertBefore(note, tableEl);
        } else {
          log(
            'transfer note: no place to insert it; ' +
              count +
              ' transfer rows hidden',
          );
        }
      }
      var spanEl = note.children && note.children[0];
      var btnEl = note.children && note.children[1];
      if (spanEl) spanEl.textContent = noteText;
      if (btnEl) btnEl.textContent = btnLabel;
    } catch (err) {
      log(
        'applyTransfers failed (non-fatal):',
        err && err.message ? err.message : err,
      );
    }
  }

  /* ------------------------------------------------------------------ */
  /* Income group to the top                                             */
  /* ------------------------------------------------------------------ */

  function isCategoryRow(row) {
    return !!row.querySelector('[data-testid="category-name"]');
  }

  function isGroupHeaderRow(row) {
    if (isCategoryRow(row)) return false;
    var t = (row.textContent || '').trim();
    if (!t) return false;
    if (/^add\s/i.test(t)) return false;
    return true;
  }

  // Leaf element inside `row` whose text is exactly `name` (group header
  // name is a bare div; category names carry data-testid="category-name").
  function findGroupNameLeaf(row, name) {
    var all = row.querySelectorAll('*');
    for (var i = 0; i < all.length; i++) {
      var el = all[i];
      if (
        el.children.length === 0 &&
        (el.textContent || '').trim() === name &&
        el.getAttribute('data-testid') !== 'category-name'
      ) {
        return el;
      }
    }
    return null;
  }

  function moveIncomeDesktop() {
    var container = document.querySelector(
      '[data-testid="budget-table-scroll-container"]',
    );
    if (!container) return false;
    var rows = [];
    for (var i = 0; i < container.children.length; i++) {
      rows.push(container.children[i]);
    }
    if (!rows.length) return false;

    var incomeIdx = -1;
    for (var j = 0; j < rows.length; j++) {
      if (!isGroupHeaderRow(rows[j])) continue;
      if (findGroupNameLeaf(rows[j], 'Income')) {
        incomeIdx = j;
        break;
      }
    }
    if (incomeIdx === -1) return false;

    // The Income block: header + its category rows, up to the next header.
    var block = [rows[incomeIdx]];
    for (var k = incomeIdx + 1; k < rows.length; k++) {
      if (!isCategoryRow(rows[k])) break;
      block.push(rows[k]);
    }

    var firstHeaderIdx = -1;
    for (var m = 0; m < rows.length; m++) {
      if (isGroupHeaderRow(rows[m])) {
        firstHeaderIdx = m;
        break;
      }
    }
    if (firstHeaderIdx === -1 || firstHeaderIdx === incomeIdx) return true; // already on top

    var anchor = rows[firstHeaderIdx];
    var prev = null;
    for (var n = 0; n < block.length; n++) {
      if (prev === null) container.insertBefore(block[n], anchor);
      else container.insertBefore(block[n], prev.nextSibling);
      prev = block[n];
    }
    return true;
  }

  function moveIncomeNarrow() {
    var groups = document.querySelector('[data-testid="budget-groups"]');
    if (!groups) return false;
    var groupRows = groups.querySelectorAll(
      '[data-testid="category-group-row"]',
    );
    var incomeRow = null;
    for (var i = 0; i < groupRows.length; i++) {
      var nameEl = groupRows[i].querySelector(
        '[data-testid="category-group-name"]',
      );
      if (nameEl && (nameEl.textContent || '').trim() === 'Income') {
        incomeRow = groupRows[i];
        break;
      }
    }
    if (!incomeRow) return false;
    if (incomeRow === groupRows[0]) return true; // already on top
    var block = [incomeRow];
    var sib = incomeRow.nextSibling;
    while (sib) {
      if (
        sib.nodeType === 1 &&
        sib.getAttribute('data-testid') === 'category-row'
      ) {
        block.push(sib);
        sib = sib.nextSibling;
      } else {
        break;
      }
    }
    var prev = null;
    for (var j = 0; j < block.length; j++) {
      if (prev === null) groups.insertBefore(block[j], groupRows[0]);
      else groups.insertBefore(block[j], prev.nextSibling);
      prev = block[j];
    }
    return true;
  }

  function moveIncomeToTop() {
    // Narrow (mobile) layout uses explicit group testids; desktop does not.
    if (document.querySelector('[data-testid="budget-groups"]')) {
      return moveIncomeNarrow();
    }
    return moveIncomeDesktop();
  }

  /* ------------------------------------------------------------------ */
  /* Green income amounts                                                */
  /* ------------------------------------------------------------------ */

  function colorIncomeGreen() {
    // Find the Income block (wherever it now sits) and colour its amounts.
    var names = document.querySelectorAll('[data-testid="category-name"]');
    var incomeCat = null;
    var startingCat = null;
    for (var i = 0; i < names.length; i++) {
      var t = (names[i].textContent || '').trim();
      if (t === 'Income') incomeCat = names[i];
      if (t === 'Starting Balances') startingCat = names[i];
    }
    if (!incomeCat && !startingCat) return;

    // Colour the amounts on the Income / Starting Balances category rows.
    var targets = [];
    if (incomeCat) targets.push(incomeCat);
    if (startingCat) targets.push(startingCat);
    for (var j = 0; j < targets.length; j++) {
      var row = targets[j];
      for (var d = 0; d < 6 && row; d++) {
        row = row.parentElement;
        if (!row) break;
        var leaves = row.querySelectorAll('*');
        var found = false;
        for (var k = 0; k < leaves.length; k++) {
          if (isNumberLeaf(leaves[k])) {
            var v = parseAmount(leaves[k].textContent);
            if (v !== null && v > 0) {
              setTextColor(leaves[k], GREEN);
              found = true;
            }
          }
        }
        if (found) break;
      }
    }

    // Colour the Income group header total (the received total).
    var container = document.querySelector(
      '[data-testid="budget-table-scroll-container"]',
    );
    if (container) {
      var rows = container.children;
      for (var m = 0; m < rows.length; m++) {
        if (!isGroupHeaderRow(rows[m])) continue;
        if (!findGroupNameLeaf(rows[m], 'Income')) continue;
        var headerLeaves = rows[m].querySelectorAll('*');
        for (var n = 0; n < headerLeaves.length; n++) {
          if (isNumberLeaf(headerLeaves[n])) {
            var hv = parseAmount(headerLeaves[n].textContent);
            if (hv !== null && hv > 0) setTextColor(headerLeaves[n], GREEN);
          }
        }
        break;
      }
    }
  }

  /* ------------------------------------------------------------------ */
  /* Red overspend line                                                  */
  /* ------------------------------------------------------------------ */

  function colorOverspentRed() {
    var summaries = document.querySelectorAll(
      '[data-testid="budget-summary"]',
    );
    for (var s = 0; s < summaries.length; s++) {
      var all = summaries[s].querySelectorAll('*');
      for (var i = 0; i < all.length; i++) {
        var el = all[i];
        if (el.children.length !== 0) continue;
        if (!/^Overspent in /.test((el.textContent || '').trim())) continue;
        var labelsCol = el.parentElement;
        if (!labelsCol) continue;
        var idx = Array.prototype.indexOf.call(labelsCol.children, el);
        var rowView = labelsCol.parentElement;
        if (!rowView) continue;
        var valuesCol = rowView.children[0];
        if (!valuesCol || valuesCol === labelsCol) continue;
        var valueEl = valuesCol.children[idx];
        if (!valueEl) continue;
        var v = parseAmount(valueEl.textContent);
        if (v !== null && v < 0) {
          setTextColor(valueEl, RED);
          setTextColor(el, RED);
        }
      }
    }
  }

  /* ------------------------------------------------------------------ */
  /* Main                                                                */
  /* ------------------------------------------------------------------ */

  function apply() {
    try {
      if (isBudgetPage()) {
        moveIncomeToTop();
        colorIncomeGreen();
        colorOverspentRed();
        ensureAdditions();
      }
      if (isUncategorizedView()) {
        applyTransfers();
      }
    } catch (e) {
      log('apply failed (non-fatal):', e && e.message ? e.message : e);
    }
  }

  var scheduled = false;
  function scheduleApply() {
    if (scheduled) return;
    scheduled = true;
    setTimeout(function () {
      scheduled = false;
      apply();
    }, 250);
  }

  function init() {
    try {
      apply();
      var root = document.getElementById('root') || document.body;
      if (root && window.MutationObserver) {
        var obs = new MutationObserver(scheduleApply);
        obs.observe(root, { childList: true, subtree: true });
      }
    } catch (e) {
      log('init failed (non-fatal):', e && e.message ? e.message : e);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
