      b.retirement = live.retirementA + live.retirementB;
      b.retirementA = live.retirementA;
      b.retirementB = live.retirementB;
      b.live = true;
    } else {
      b.retirement = FALLBACK.retirementA + FALLBACK.retirementB;
      b.retirementA = FALLBACK.retirementA;
      b.retirementB = FALLBACK.retirementB;
    }
    if (hasAll(live, ['brokerageA', 'brokerageB', 'brokerageC'])) {
      b.brokerage =
        live.brokerageA + live.brokerageB + live.brokerageC;
      b.brokerageA = live.brokerageA;
      b.brokerageB = live.brokerageB;
      b.brokerageC = live.brokerageC;
      b.live = true;
    } else {
